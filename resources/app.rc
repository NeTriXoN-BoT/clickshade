#include <windows.h>
1 ICON "app.ico"
1 RT_MANIFEST "app.manifest"
1 VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "ClickShade contributors\0"
      VALUE "FileDescription", "ClickShade\0"
      VALUE "FileVersion", "1.0\0"
      VALUE "InternalName", "ClickShade\0"
      VALUE "LegalCopyright", "MIT License. Copyright (c) ClickShade contributors.\0"
      VALUE "OriginalFilename", "ClickShade.exe\0"
      VALUE "ProductName", "ClickShade\0"
      VALUE "ProductVersion", "1.0\0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
